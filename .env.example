# DeepSeek 在线聊天必需；不要把真实 Key 提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=3
DEEPSEEK_READ_TIMEOUT_SECONDS=50

# 可选：langchain 或 llamaindex
RAG_ENGINE=langchain

# 可选：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Phase 3 Python AI Service Skeleton；仅绑定本机，生产部署需显式覆盖
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# Phase 3 Java Backend Skeleton；Spring Boot 从系统环境读取，不直接加载本文件
JAVA_BACKEND_PORT=8080
PYTHON_AI_BASE_URL=http://127.0.0.1:8000
